# ==============================================================================
# Lazee.dev - Environment Variables Example
# Copy this file to .env.local for local development:
#   cp .env.example .env.local (or run `npm run setup`)
# ==============================================================================

# Database (PostgreSQL - matches docker-compose.yml defaults)
DATABASE_URL="postgresql://postgres:password@localhost:5432/lazee?schema=public"

# NextAuth / Auth.js
AUTH_SECRET="local-dev-auth-secret-do-not-use-in-production"
NEXTAUTH_SECRET="local-dev-auth-secret-do-not-use-in-production"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Local Developer Bypass Mode
# Enables 1-Click login as dev@lazee.dev without needing Google OAuth or SMTP
ENABLE_DEV_LOGIN="true"
NEXT_PUBLIC_ENABLE_DEV_LOGIN="true"

# Google OAuth (Optional for local contribution - leave dummy or set up GCP credentials)
AUTH_GOOGLE_CLIENT_ID="dummy-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_CLIENT_SECRET="GOCSPX-dummy-google-client-secret"

# Email / SMTP (Optional for local contribution - uses Ethereal test mailer by default)
EMAIL_SERVER_HOST="smtp.ethereal.email"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="dummy_user@ethereal.email"
EMAIL_SERVER_PASSWORD="dummy_password"
EMAIL_FROM="Lazee.dev <no-reply@lazee.dev>"

# Cloudflare R2 / S3 Storage (Optional - dummy values work for local non-upload testing)
CLOUDFLARE_S3_BUCKET="https://dummy.r2.cloudflarestorage.com/lazee"
S3_BUCKET_NAME="lazee"
S3_ACCESS_KEY_ID="dummy-access-key-id"
S3_SECRET_ACCESS_KEY="dummy-secret-access-key"
AWS_ACCESS_KEY_ID="dummy-access-key-id"
AWS_SECRET_ACCESS_KEY="dummy-secret-access-key"
AWS_REGION="auto"
NEXT_PUBLIC_R2_PUBLIC_URL="https://pub-889628534b094cf89bcd7cd93528323d.r2.dev"

# Dodo Payments (Optional - test mode dummy keys)
NEXT_PUBLIC_DODO_PAYMENTS_PRODUCT_ID="p_dummy_product_id"
DODO_PAYMENTS_API_KEY="test_dummy_key"
DODO_PAYMENTS_ENVIRONMENT="test_mode"
DODO_PAYMENTS_RETURN_URL="http://localhost:3000/profile"
DODO_PAYMENTS_WEBHOOK_KEY="dummy_webhook_key"

# AI / OpenRouter (Optional - dummy key for UI testing, real key for AI generation)
OPENROUTER_API_KEY="dummy_openrouter_api_key"
AI_MODEL="meta-llama/llama-3-8b-instruct"

# Notion (Optional - feedback syncing)
NOTION_API_KEY="dummy_notion_api_key"
NOTION_FEEDBACK_DATABASE_ID="dummy_notion_database_id"
